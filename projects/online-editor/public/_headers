# HTML 파일 Content-Type 명시 (최우선)
/index.html
  Content-Type: text/html; charset=utf-8
  X-Content-Type-Options: nosniff

/*
  Content-Type: text/html; charset=utf-8
  X-Content-Type-Options: nosniff

# Pyodide 보안 헤더 (Python 실행을 위해 필요)
/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Referrer-Policy: origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; child-src 'self' blob:;

# SVG 파일 MIME 타입 설정
*.svg
  Content-Type: image/svg+xml

# 정적 자산 캐싱 최적화
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/icon*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/logo.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable